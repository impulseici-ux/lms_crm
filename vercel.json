{
  "installCommand": "cd web && npm ci && cd ../backend && npm ci",
  "buildCommand": "npm run build:dev",
  "outputDirectory": "web/dist",
  "functions": {
    "backend/api/**/*.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/backend/api/:path*" }
  ]
}
