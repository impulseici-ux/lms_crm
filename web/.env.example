# Template for the Firebase web config Vite needs to build against.
# For emulator-based local dev, copy this to .env.local (see README's
# "Local development" section) and leave VITE_USE_EMULATORS=true.
#
# For deploying to a real project, this repo runs TWO separate Firebase
# projects — dev and prod (see README's "Dev vs. prod environments"). Copy
# this file to BOTH of the following, filling each with that environment's
# own project's config (Firebase Console → Project settings → General →
# Your apps → SDK setup and config):
#   web/.env.dev.local    (used by `npm run build:dev`)
#   web/.env.prod.local   (used by `npm run build:prod`)
#
# These use custom Vite modes ("dev"/"prod") rather than Vite's built-in
# "development"/"production" modes on purpose — `npm run dev` (the emulator
# dev server) defaults to Vite's "development" mode, and a
# .env.development.local file would silently override .env.local's
# VITE_USE_EMULATORS=true whenever someone ran it locally.
#
# Never point either at a project used by anything else (e.g. IM Enterprise
# Finance) — each environment gets its own, dedicated Firebase project.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect to the local Firebase Emulator Suite instead of
# live Firebase. Only relevant for .env.local (emulator dev) — leave this
# "false" in both .env.development.local and .env.production.local.
VITE_USE_EMULATORS=true
