# Copy to .env.local and fill in with your real Firebase project's web config
# (Firebase Console → Project settings → General → Your apps → SDK setup and config).
# This CRM must live in its own, separate Firebase project — see Section 17
# of the blueprint. Never point it at the IM Enterprise Finance project.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect to the local Firebase Emulator Suite instead of
# live Firebase (recommended for all local development — see README).
VITE_USE_EMULATORS=true
